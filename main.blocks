<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="Me^_I;,LMMSUD!t{B;?s" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="vKQ]CXA#e!ojU0l7Kx92"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace CollisionHandler {" line1="" line2="    export enum PushDirection {" line3="        //% block=&quot;left and right&quot;" line4="        X_Axis," line5="        //% block=&quot;up and down&quot;" line6="        Y_Axis," line7="        //% block=&quot;any direction&quot;" line8="        Omnidirectional" line9="    }" line10="" line11="    class Rule {" line12="        constructor(" line13="            public a: Sprite | number," line14="            public b: Sprite | number," line15="            public pushable: boolean," line16="            public direction: PushDirection," line17="            public pushSpeed: number // 0 = as fast as the pusher moves" line18="        ) { }" line19="    }" line20="" line21="    // Set up lazily: in the extension's own test run, test.ts can run" line22="    // before this file's top-level code, so these may still be undefined." line23="    let rules: Rule[];" line24="    let scenesWithHandler: scene.Scene[];" line25="" line26="    /**" line27="     * Stop a sprite (or every sprite of a kind) when it runs into another sprite or kind." line28="     * Use once, in &quot;on start&quot;." line29="     */" line30="    //% block=&quot;stop $spriteA when colliding with $spriteB&quot;" line31="    //% group=&quot;Solid Collisions&quot;" line32="    //% spriteA.shadow=variables_get" line33="    //% spriteA.defl=mySprite" line34="    //% spriteB.shadow=spritekind" line35="    export function handleSolidCollision(spriteA: Sprite | number, spriteB: Sprite | number) {" line36="        addRule(spriteA, spriteB, false, PushDirection.Omnidirectional, 0);" line37="    }" line38="" line39="    /**" line40="     * Let a sprite (or every sprite of a kind) push another sprite or kind." line41="     * Pushed sprites stop at walls, at the edge of the tilemap and at each other." line42="     * Works for players too: use the same kind twice (e.g. Player pushes Player)" line43="     * and whoever walks into the other one does the pushing." line44="     * Click + to set a push speed (pixels per second): heavy things get pushed slowly" line45="     * and slow the pusher down. Without it, things move as fast as the pusher." line46="     * Use once, in &quot;on start&quot;." line47="     */" line48="    //% block=&quot;allow $spriteA to push $spriteB in $direction||at speed $speed&quot;" line49="    //% group=&quot;Pushable Collisions&quot;" line50="    //% spriteA.shadow=variables_get" line51="    //% spriteA.defl=mySprite" line52="    //% spriteB.shadow=spritekind" line53="    //% direction.defl=CollisionHandler.PushDirection.Omnidirectional" line54="    //% speed.defl=30 speed.min=1 speed.max=200" line55="    //% expandableArgumentMode=&quot;toggle&quot;" line56="    export function handlePushableCollision(spriteA: Sprite | number, spriteB: Sprite | number, direction: PushDirection, speed?: number) {" line57="        addRule(spriteA, spriteB, true, direction, speed &gt; 0 ? speed : 0);" line58="    }" line59="" line60="    function addRule(a: Sprite | number, b: Sprite | number, pushable: boolean, direction: PushDirection, pushSpeed: number) {" line61="        if (!rules) rules = [];" line62="        if (!scenesWithHandler) scenesWithHandler = [];" line63="        // Same pair added again (e.g. block inside a loop): update it instead of stacking" line64="        let existing: Rule = null;" line65="        for (const r of rules) {" line66="            if (r.a === a &amp;&amp; r.b === b) existing = r;" line67="        }" line68="        if (existing) {" line69="            existing.pushable = pushable;" line70="            existing.direction = direction;" line71="            existing.pushSpeed = pushSpeed;" line72="        } else {" line73="            rules.push(new Rule(a, b, pushable, direction, pushSpeed));" line74="        }" line75="" line76="        // One update handler per scene, no matter how many rules" line77="        const current = game.currentScene();" line78="        if (scenesWithHandler.indexOf(current) &lt; 0) {" line79="            scenesWithHandler.push(current);" line80="            game.onUpdate(step);" line81="        }" line82="    }" line83="" line84="    function resolveList(target: Sprite | number): Sprite[] {" line85="        if (typeof target === &quot;number&quot;) return sprites.allOfKind(target as number);" line86="        const s = target as Sprite;" line87="        return s ? [s] : [];" line88="    }" line89="" line90="    function isAlive(s: Sprite): boolean {" line91="        return s &amp;&amp; !(s.flags &amp; sprites.Flag.Destroyed);" line92="    }" line93="" line94="    // A few passes per frame, so stacks and chains (box on box on player...)" line95="    // settle in one frame instead of sinking into each other." line96="    // Settings are left undefined until set: a game's code can run before this" line97="    // file's top-level code (in the extension's own test), which would reset them." line98="    let maxPasses: number; // default 4, &quot;set collision passes&quot;" line99="    // Contacts with this much (or less) vertical overlap count as standing / landing /" line100="    // stepping up, so walking over a row of sprites never catches on their corners." line101="    let stepUp: number; // default 3, &quot;set step up height&quot;" line102="" line103="    // Sprite lists for each rule, looked up once per frame (sprites.allOfKind is not free)" line104="    let listsA: Sprite[][] = [];" line105="    let listsB: Sprite[][] = [];" line106="" line107="    // Per-frame lookup tables, so nothing has to search through lists:" line108="    // every tracked sprite gets a number (sprite.data.__swi) for this frame." line109="    let inA: number[][] = [];        // inA[rule][spriteNo] = 1 if in that rule's A side" line110="    let inB: number[][] = [];" line111="    let blockerLists: number[][] = []; // everything a sprite collides with (as numbers)" line112="    let idxA: number[][] = [];         // each rule's sprites as numbers" line113="    let idxB: number[][] = [];" line114="    let movable: boolean[] = [];" line115="" line116="    function step() {" line117="        frameNo++;" line118="        listsA = [];" line119="        listsB = [];" line120="        tracked = [];" line121="        for (const rule of rules) {" line122="            const la = resolveList(rule.a);" line123="            const lb = resolveList(rule.b);" line124="            listsA.push(la);" line125="            listsB.push(lb);" line126="            for (const t of la) track(t);" line127="            for (const u of lb) track(u);" line128="        }" line129="        // Remember speeds before anything is corrected this frame, so later passes" line130="        // still know who was moving (and don't shove sprites that stood still)." line131="        for (const v of tracked) snapshot(v);" line132="" line133="        const n = tracked.length;" line134="        inA = [];" line135="        inB = [];" line136="        idxA = [];" line137="        idxB = [];" line138="        blockerLists = [];" line139="        movable = [];" line140="        for (let i = 0; i &lt; n; i++) {" line141="            blockerLists.push([]);" line142="            movable.push(false);" line143="        }" line144="        for (let w = 0; w &lt; rules.length; w++) {" line145="            const ma: number[] = [];" line146="            const mb: number[] = [];" line147="            for (let j = 0; j &lt; n; j++) { ma.push(0); mb.push(0); }" line148="            const ia: number[] = [];" line149="            const ib: number[] = [];" line150="            for (const a of listsA[w]) ia.push(spriteNo(a));" line151="            for (const b of listsB[w]) ib.push(spriteNo(b));" line152="            idxA.push(ia);" line153="            idxB.push(ib);" line154="            for (const k of ia) ma[k] = 1;" line155="            for (const l of ib) mb[l] = 1;" line156="            inA.push(ma);" line157="            inB.push(mb);" line158="            for (const m of ia) {" line159="                const list = blockerLists[m];" line160="                for (const o of ib) if (o != m) list.push(o);" line161="            }" line162="            for (const p of ib) {" line163="                const list2 = blockerLists[p];" line164="                for (const q of ia) if (q != p) list2.push(q);" line165="            }" line166="        }" line167="        for (let c = 0; c &lt; n; c++) {" line168="            const d = tracked[c];" line169="            let e = false;" line170="            for (let f = 0; f &lt; rules.length &amp;&amp; !e; f++) {" line171="                if (inA[f][c] || (rules[f].pushable &amp;&amp; inB[f][c])) e = true;" line172="            }" line173="            movable[c] = e &amp;&amp; getFor(d, &quot;pushable&quot;, 1) != 0;" line174="        }" line175="" line176="        applyCarry();" line177="" line178="        const passes = maxPasses === undefined ? 4 : maxPasses;" line179="        for (let pass = 0; pass &lt; passes; pass++) {" line180="            // Side hits first (sprites at the same height), then landing/standing." line181="            // Otherwise a sprite pressed against a stack could &quot;stand&quot; on the corner below." line182="            const sides = runPhase(true);" line183="            const rest = runPhase(false);" line184="            if (!sides &amp;&amp; !rest) break;" line185="        }" line186="" line187="        rememberStanding();" line188="    }" line189="" line190="    // ---------- Carrying: whatever stands on a sprite moves along with it ----------" line191="    let tracked: Sprite[] = [];" line192="    let frameNo = 0;" line193="" line194="    function track(s: Sprite) {" line195="        if (s.data[&quot;__swst&quot;] === frameNo) return; // already listed this frame" line196="        s.data[&quot;__swst&quot;] = frameNo;" line197="        s.data[&quot;__swi&quot;] = tracked.length;" line198="        tracked.push(s);" line199="    }" line200="" line201="    // This frame's number for a sprite, or -1 if no rule covers it" line202="    function spriteNo(s: Sprite): number {" line203="        return s.data[&quot;__swst&quot;] === frameNo ? s.data[&quot;__swi&quot;] : -1;" line204="    }" line205="" line206="    function isIn(table: number[][], r: number, s: Sprite): boolean {" line207="        const g = spriteNo(s);" line208="        return g &gt;= 0 &amp;&amp; table[r][g] == 1;" line209="    }" line210="    const MAX_CARRY_STEP = 8; // bigger jumps are teleports (setPosition), not walking" line211="" line212="    function applyCarry() {" line213="        const dt = game.eventContext().deltaTime;" line214="        for (const h of tracked) {" line215="            if (!isAlive(h)) continue;" line216="            const moved = totalMove(h, 0);" line217="            // A carried sprite has no speed of its own, but it IS moving: use its real" line218="            // movement as its speed, so bumping into things counts as a side hit." line219="            if (dt &gt; 0 &amp;&amp; h.data[&quot;__swon&quot;]) h.data[&quot;__swvx&quot;] = moved / dt;" line220="        }" line221="        // Remember where everything is now, to measure next frame's movement" line222="        for (const s2 of tracked) s2.data[&quot;__swlx&quot;] = s2.x;" line223="    }" line224="" line225="    // How far s moved sideways this frame: its own movement plus what carried it." line226="    // Works up a stack: a rider on a rider on a walker moves with the walker." line227="    function totalMove(s: Sprite, depth: number): number {" line228="        if (s.data[&quot;__swfr&quot;] === frameNo) return s.data[&quot;__swmv&quot;];" line229="        s.data[&quot;__swfr&quot;] = frameNo;" line230="        s.data[&quot;__swmv&quot;] = 0; // guards against loops" line231="" line232="        const lx = s.data[&quot;__swlx&quot;];" line233="        let own = lx === undefined ? 0 : s.x - lx;" line234="        if (Math.abs(own) &gt; MAX_CARRY_STEP) own = 0;" line235="" line236="        let carry = 0;" line237="        const on: Sprite = s.data[&quot;__swon&quot;];" line238="        if (on &amp;&amp; isAlive(on) &amp;&amp; depth &lt; 16 &amp;&amp; getFor(on, &quot;carries&quot;, 1) != 0) {" line239="            carry = totalMove(on, depth + 1);" line240="            // ride along, unless a wall is in the way (then slide off)" line241="            if (carry != 0 &amp;&amp; canMoveTo(s, carry, 0, on, NONE)) s.x += carry;" line242="            else carry = 0;" line243="        }" line244="        s.data[&quot;__swmv&quot;] = own + carry;" line245="        return own + carry;" line246="    }" line247="" line248="    // After everything is settled: who is standing on whom?" line249="    function rememberStanding() {" line250="        refreshBounds();" line251="        for (let i2 = 0; i2 &lt; tracked.length; i2++) {" line252="            const s3 = tracked[i2];" line253="            if (!isAlive(s3)) continue;" line254="            let best: Sprite = null;" line255="            let bestOverlap = 0;" line256="            for (const j2 of blockerLists[i2]) {" line257="                if (Math.abs(bB[i2] - bT[j2]) &gt; 1) continue;" line258="                const ov = Math.min(bR[i2], bR[j2]) - Math.max(bL[i2], bL[j2]);" line259="                if (ov &gt; bestOverlap &amp;&amp; isAlive(tracked[j2])) { bestOverlap = ov; best = tracked[j2]; }" line260="            }" line261="            s3.data[&quot;__swon&quot;] = best;" line262="        }" line263="    }" line264="" line265="    // Cached edges of every tracked sprite (sprite.left etc. are function calls," line266="    // which adds up over hundreds of pairs). Refreshed each phase and after moves." line267="    let bL: number[] = [];" line268="    let bT: number[] = [];" line269="    let bR: number[] = [];" line270="    let bB: number[] = [];" line271="" line272="    function refreshBounds() {" line273="        bL = []; bT = []; bR = []; bB = [];" line274="        for (const s4 of tracked) {" line275="            bL.push(s4.left); bT.push(s4.top); bR.push(s4.right); bB.push(s4.bottom);" line276="        }" line277="    }" line278="" line279="    function refreshOne(s: Sprite) {" line280="        const i3 = spriteNo(s);" line281="        if (i3 &lt; 0) return;" line282="        bL[i3] = s.left; bT[i3] = s.top; bR[i3] = s.right; bB[i3] = s.bottom;" line283="    }" line284="" line285="    function runPhase(sideHitsOnly: boolean): boolean {" line286="        refreshBounds();" line287="        let changed = false;" line288="        for (let r2 = 0; r2 &lt; rules.length; r2++) {" line289="            const rule2 = rules[r2];" line290="            const nA = idxA[r2];" line291="            const nB = idxB[r2];" line292="            for (const ia2 of nA) {" line293="                const a2 = tracked[ia2];" line294="                if (!isAlive(a2)) continue;" line295="                for (const ib2 of nB) {" line296="                    if (ia2 == ib2) continue;" line297="                    // quick reject from the cached edges: too far apart to touch" line298="                    if (bL[ia2] &gt;= bR[ib2] || bL[ib2] &gt;= bR[ia2] || bT[ia2] &gt;= bB[ib2] || bT[ib2] &gt;= bB[ia2]) continue;" line299="                    const b2 = tracked[ib2];" line300="                    if (!isAlive(b2)) continue;" line301="                    if (resolve(r2, rule2, a2, b2, sideHitsOnly)) {" line302="                        changed = true;" line303="                        refreshOne(a2);" line304="                        refreshOne(b2);" line305="                    }" line306="                }" line307="            }" line308="        }" line309="        return changed;" line310="    }" line311="" line312="    function snapshot(s: Sprite) {" line313="        if (!s) return;" line314="        s.data[&quot;__swvx&quot;] = s.vx;" line315="        s.data[&quot;__swvy&quot;] = s.vy;" line316="    }" line317="    // Speed at the start of this frame's collision step" line318="    function svx(s: Sprite): number {" line319="        const v2 = s.data[&quot;__swvx&quot;];" line320="        return v2 === undefined ? s.vx : v2;" line321="    }" line322="    function svy(s: Sprite): number {" line323="        const v3 = s.data[&quot;__swvy&quot;];" line324="        return v3 === undefined ? s.vy : v3;" line325="    }" line326="" line327="    function overlaps(l1: number, t1: number, r1: number, b1: number," line328="        l2: number, t2: number, r2: number, b2: number): boolean {" line329="        return l1 &lt; r2 &amp;&amp; r1 &gt; l2 &amp;&amp; t1 &lt; b2 &amp;&amp; b1 &gt; t2;" line330="    }" line331="" line332="    function resolve(r: number, rule: Rule, a: Sprite, b: Sprite, sideHitsOnly: boolean): boolean {" line333="        if (!overlaps(a.left, a.top, a.right, a.bottom, b.left, b.top, b.right, b.bottom)) return false;" line334="" line335="        const overlapX = Math.min(a.right - b.left, b.right - a.left);" line336="        const overlapY = Math.min(a.bottom - b.top, b.bottom - a.top);" line337="        const shallow = overlapY &lt;= (stepUp === undefined ? 3 : stepUp);" line338="        if (sideHitsOnly &amp;&amp; shallow) return false;" line339="" line340="        let alongX: boolean;" line341="        if (shallow &amp;&amp; overlapX &gt; overlapY) {" line342="            // One is just on top of the other: standing, landing or stepping up" line343="            alongX = false;" line344="        } else if (overlapX &lt;= 2 &amp;&amp; overlapY &gt; overlapX) {" line345="            // Only just touching sideways but deep vertically: a side bump" line346="            // (e.g. a carried player nudging a box), never a climb onto its corner" line347="            alongX = true;" line348="        } else {" line349="            // Which side did they hit? The axis crossed most recently:" line350="            // overlap / closing speed = time since that edge was crossed." line351="            const tX = timeSince(overlapX, svx(a) - svx(b));" line352="            const tY = timeSince(overlapY, svy(a) - svy(b));" line353="            alongX = tX != tY ? tX &lt; tY : overlapX &lt; overlapY;" line354="        }" line355="" line356="        // Direction from a towards b (+1 or -1). Same centre: use a's movement." line357="        const sx = a.x &lt; b.x ? 1 : a.x &gt; b.x ? -1 : (svx(a) &gt;= 0 ? 1 : -1);" line358="        const sy = a.y &lt; b.y ? 1 : a.y &gt; b.y ? -1 : (svy(a) &gt;= 0 ? 1 : -1);" line359="" line360="        if (rule.pushable &amp;&amp; pushAllowed(rule.direction, alongX) &amp;&amp; getFor(b, &quot;pushable&quot;, 1) != 0) {" line361="            // Both can push each other (e.g. Player pushes Player): only the one" line362="            // walking into the other pushes. The pair is also checked the other" line363="            // way round, so skip it here if b is the pusher." line364="            if (isIn(inA, r, b)) {" line365="                const aClosing = alongX ? svx(a) * sx : svy(a) * sy;" line366="                const bClosing = alongX ? -svx(b) * sx : -svy(b) * sy;" line367="                if (bClosing &gt; aClosing) return false;" line368="            }" line369="            const overlap = alongX ? overlapX : overlapY;" line370="            // b may push the next one in line, and so on (a row of players or boxes)" line371="            const chain: Sprite[] = [];" line372="            const fullX = alongX ? sx * overlap : 0;" line373="            const fullY = alongX ? 0 : sy * overlap;" line374="            if (collectPush(b, fullX, fullY, a, chain, 0)) {" line375="                // Push speed: the row moves at most as fast as its slowest member" line376="                // (its own push speed, else the push block's speed; 0 = no limit)." line377="                // The rest pushes the pusher back, so it slows down to that speed." line378="                let speed = 0;" line379="                for (const c2 of chain) {" line380="                    const cs = getFor(c2, &quot;speed&quot;, rule.pushSpeed);" line381="                    if (cs &gt; 0 &amp;&amp; (speed == 0 || cs &lt; speed)) speed = cs;" line382="                }" line383="                let amount = overlap;" line384="                if (speed &gt; 0) amount = Math.min(overlap, speed * game.eventContext().deltaTime);" line385="                const dx = alongX ? sx * amount : 0;" line386="                const dy = alongX ? 0 : sy * amount;" line387="                for (const c3 of chain) {" line388="                    c3.x += dx;" line389="                    c3.y += dy;" line390="                    refreshOne(c3);" line391="                }" line392="                const rest2 = overlap - amount;" line393="                if (rest2 &gt; 0) {" line394="                    // pusher backs off the rest (position only, keeps its speed)" line395="                    if (alongX) a.x -= sx * rest2;" line396="                    else a.y -= sy * rest2;" line397="                }" line398="                return true;" line399="            }" line400="        }" line401="" line402="        // Solid (or push blocked). Correction for a is (ax, ay); for b it's the opposite." line403="        const ax = alongX ? -sx * overlapX : 0;" line404="        const ay = alongX ? 0 : -sy * overlapY;" line405="" line406="        // Who moves? b can only be the one stopped if the rule lets it be" line407="        // (player vs player, or a pushable box)." line408="        const bStoppable = rule.pushable || isIn(inA, r, b);" line409="        let moveB = false;" line410="        if (bStoppable) {" line411="            if (alongX) {" line412="                // the one walking into the other stops; one standing still is never shoved" line413="                moveB = -svx(b) * sx &gt; svx(a) * sx;" line414="            } else {" line415="                // stacked: the upper one moves up, the lower one is never pushed down" line416="                moveB = b.y &lt; a.y;" line417="            }" line418="        }" line419="" line420="        const first = moveB ? b : a;" line421="        const second = moveB ? a : b;" line422="        const fx = moveB ? -ax : ax;" line423="        const fy = moveB ? -ay : ay;" line424="" line425="        if (!alongX) {" line426="            // Up/down: move the whole column. Lifting a sprite also lifts everything" line427="            // stacked on it; if the top of the column hits a ceiling, the column can't" line428="            // move, so the one below is pushed down instead (and stops jumping)." line429="            const chain1: Sprite[] = [];" line430="            if (collectLift(first, fy, second, chain1, 0)) {" line431="                for (const c4 of chain1) moveBy(c4, 0, fy);" line432="                return true;" line433="            }" line434="            const chain2: Sprite[] = [];" line435="            if (collectLift(second, -fy, first, chain2, 0)) {" line436="                for (const c5 of chain2) moveBy(c5, 0, -fy);" line437="                return true;" line438="            }" line439="            // Squeezed between floor and ceiling: stop them moving into each other" line440="            if (a.vy * sy &gt; 0) a.vy = 0;" line441="            if (b.vy * sy &lt; 0) b.vy = 0;" line442="            return true;" line443="        }" line444="" line445="        // Sideways: never shove a sprite into a wall or into another solid sprite" line446="        // (that's how boxes tunnelled through players)." line447="        const firstBlockers = alongX ? blockersFor(first) : NONE;" line448="        const secondBlockers = alongX ? blockersFor(second) : NONE;" line449="        if (canMoveTo(first, fx, fy, second, firstBlockers)) {" line450="            moveBy(first, fx, fy);" line451="            return true;" line452="        }" line453="        // A wall is in the way (e.g. a box landing on a player standing on the floor):" line454="        // move the other one instead." line455="        if (canMoveTo(second, -fx, -fy, first, secondBlockers)) {" line456="            moveBy(second, -fx, -fy);" line457="            return true;" line458="        }" line459="        if (alongX) {" line460="            // Squeezed between sprites on both sides: allow a sprite overlap" line461="            // (fixed in the next pass) rather than letting them sink into each other." line462="            // Only the one doing the moving: shoving the other one would push a whole" line463="            // row along even when chain pushing is limited." line464="            if (canMoveTo(first, fx, fy, second, NONE)) { moveBy(first, fx, fy); return true; }" line465="        }" line466="        // Both are against walls: try the other axis, otherwise leave them" line467="        // overlapping rather than shove a sprite into a wall (it would fall through)." line468="        const ox = alongX ? 0 : -sx * overlapX;" line469="        const oy = alongX ? -sy * overlapY : 0;" line470="        if (canMoveTo(a, ox, oy, b, blockersFor(a))) {" line471="            moveBy(a, ox, oy);" line472="        } else {" line473="            // Stuck for now: at least stop them moving further into each other" line474="            if (alongX) {" line475="                if (a.vx * sx &gt; 0) a.vx = 0;" line476="                if (b.vx * sx &lt; 0) b.vx = 0;" line477="            } else {" line478="                if (a.vy * sy &gt; 0) a.vy = 0;" line479="                if (b.vy * sy &lt; 0) b.vy = 0;" line480="            }" line481="        }" line482="        return true;" line483="    }" line484="" line485="    // Move a sprite and stop its speed only on the axis it was pushed back along" line486="    function moveBy(s: Sprite, dx: number, dy: number) {" line487="        s.x += dx;" line488="        s.y += dy;" line489="        refreshOne(s);" line490="        if (dx != 0 &amp;&amp; s.vx * dx &lt; 0) s.vx = 0;" line491="        if (dy != 0 &amp;&amp; s.vy * dy &lt; 0) s.vy = 0;" line492="    }" line493="" line494="    function timeSince(overlap: number, relSpeed: number): number {" line495="        const speed2 = Math.abs(relSpeed);" line496="        return speed2 &lt; 1 ? 999999 : overlap / speed2;" line497="    }" line498="" line499="    function pushAllowed(direction: PushDirection, alongX: boolean): boolean {" line500="        if (direction === PushDirection.X_Axis) return alongX;" line501="        if (direction === PushDirection.Y_Axis) return !alongX;" line502="        return true;" line503="    }" line504="" line505="    // Every sprite that b collides with under any rule (players, other boxes, gates...)" line506="    // (built once per frame in step)" line507="    const NONE: number[] = [];" line508="    function blockersFor(b: Sprite): number[] {" line509="        const i4 = spriteNo(b);" line510="        return i4 &gt;= 0 ? blockerLists[i4] : NONE;" line511="    }" line512="" line513="    // Can s move by (dx, dy)? Anything in the way that s is allowed to push (by any" line514="    // push rule) gets pushed too and is added to chain: a player pushing a row of" line515="    // players pushes the box at the end as well. Walls and other sprites block." line516="    function collectPush(s: Sprite, dx: number, dy: number, pusher: Sprite, chain: Sprite[], depth: number): boolean {" line517="        if (!canMoveTo(s, dx, dy, pusher, NONE)) return false; // walls" line518="        const sl = s.left, st = s.top, sr = s.right, sb = s.bottom;" line519="        const l2 = sl + dx, t2 = st + dy, r3 = sr + dx, btm = sb + dy;" line520="        for (const j3 of blockersFor(s)) {" line521="            const o2 = tracked[j3];" line522="            if (o2 === pusher) continue;" line523="            if (overlaps(sl, st, sr, sb, bL[j3], bT[j3], bR[j3], bB[j3])) continue;" line524="            if (!overlaps(l2, t2, r3, btm, bL[j3], bT[j3], bR[j3], bB[j3])) continue;" line525="            if (!isAlive(o2) || chain.indexOf(o2) &gt;= 0) continue;" line526="            if (depth &lt; (chainLimit === undefined ? 8 : chainLimit) &amp;&amp; canPush(s, o2, dx != 0)" line527="                &amp;&amp; collectPush(o2, dx, dy, s, chain, depth + 1)) continue;" line528="            return false;" line529="        }" line530="        if (chain.indexOf(s) &lt; 0) chain.push(s);" line531="        return true;" line532="    }" line533="" line534="    // Can s move up/down by dy? Sprites in the way that can move (not walls or" line535="    // fixed sprites like gates) are moved too and added to chain." line536="    function collectLift(s: Sprite, dy: number, from: Sprite, chain: Sprite[], depth: number): boolean {" line537="        if (!canMoveTo(s, 0, dy, from, NONE)) return false; // walls / ceiling / floor" line538="        const sl2 = s.left, st2 = s.top, sr2 = s.right, sb2 = s.bottom;" line539="        const sMid = (st2 + sb2) / 2;" line540="        const t3 = st2 + dy, btm2 = sb2 + dy;" line541="        for (const j4 of blockersFor(s)) {" line542="            // only what's on the side we're moving towards" line543="            const oMid = (bT[j4] + bB[j4]) / 2;" line544="            if (dy &lt; 0 ? oMid &gt;= sMid : oMid &lt;= sMid) continue;" line545="            if (!overlaps(sl2, t3, sr2, btm2, bL[j4], bT[j4], bR[j4], bB[j4])) continue;" line546="            const o3 = tracked[j4];" line547="            if (o3 === from || !isAlive(o3) || chain.indexOf(o3) &gt;= 0) continue;" line548="            if (!isMovable(o3)) {" line549="                // fixed sprite: only blocks if we'd newly run into it" line550="                if (overlaps(sl2, st2, sr2, sb2, bL[j4], bT[j4], bR[j4], bB[j4])) continue;" line551="                return false;" line552="            }" line553="            // move o just enough to clear s's new position" line554="            const need = dy &lt; 0 ? bB[j4] - t3 : btm2 - bT[j4];" line555="            if (need &lt;= 0) continue;" line556="            if (depth &gt;= 8) return false;" line557="            const sub: Sprite[] = [];" line558="            if (!collectLift(o3, dy &lt; 0 ? -need : need, s, sub, depth + 1)) return false;" line559="            // o and its column move by their own amount right away" line560="            for (const c6 of sub) if (chain.indexOf(c6) &lt; 0) moveBy(c6, 0, dy &lt; 0 ? -need : need);" line561="        }" line562="        if (chain.indexOf(s) &lt; 0) chain.push(s);" line563="        return true;" line564="    }" line565="" line566="    // Can this sprite be moved by collisions? (Sprites only ever named as the" line567="    // &quot;wall&quot; side of solid rules, like a gate, can't.)" line568="    // (worked out once per frame in step; &quot;can be pushed off&quot; = bolted in place)" line569="    function isMovable(o: Sprite): boolean {" line570="        const i5 = spriteNo(o);" line571="        return i5 &gt;= 0 &amp;&amp; movable[i5];" line572="    }" line573="" line574="    function canPush(s: Sprite, o: Sprite, alongX: boolean): boolean {" line575="        if (getFor(o, &quot;pushable&quot;, 1) == 0) return false;" line576="        for (let r4 = 0; r4 &lt; rules.length; r4++) {" line577="            const rule3 = rules[r4];" line578="            if (!rule3.pushable || !pushAllowed(rule3.direction, alongX)) continue;" line579="            if (isIn(inA, r4, s) &amp;&amp; isIn(inB, r4, o)) return true;" line580="        }" line581="        return false;" line582="    }" line583="" line584="    // Can b move by (dx, dy) without hitting a wall tile, the tilemap edge or one of `others`?" line585="    // (`pusher` is ignored: it's the sprite b is being separated from.)" line586="    function canMoveTo(b: Sprite, dx: number, dy: number, pusher: Sprite, others: number[]): boolean {" line587="        const l3 = b.left + dx;" line588="        const t4 = b.top + dy;" line589="        const r5 = b.right + dx;" line590="        const btm3 = b.bottom + dy;" line591="" line592="        const tm = game.currentScene().tileMap;" line593="        if (tm &amp;&amp; tm.enabled) {" line594="            const size = 1 &lt;&lt; tm.scale;" line595="            const c0 = Math.floor(l3 / size);" line596="            const c1 = Math.floor((r5 - 1) / size);" line597="            const r0 = Math.floor(t4 / size);" line598="            const r1 = Math.floor((btm3 - 1) / size);" line599="            for (let c7 = c0; c7 &lt;= c1; c7++) {" line600="                for (let row = r0; row &lt;= r1; row++) {" line601="                    // isObstacle is also true outside the map, so this covers the edges" line602="                    if (tm.isObstacle(c7, row)) return false;" line603="                }" line604="            }" line605="        }" line606="" line607="        if (others.length == 0) return true;" line608="        const bl = b.left, bt = b.top, br = b.right, bb = b.bottom;" line609="        for (const j5 of others) {" line610="            // Already overlapping it? That contact gets sorted out on its own," line611="            // so it doesn't block (lets whole stacks push apart bottom-up)." line612="            if (overlaps(bl, bt, br, bb, bL[j5], bT[j5], bR[j5], bB[j5])) continue;" line613="            if (!overlaps(l3, t4, r5, btm3, bL[j5], bT[j5], bR[j5], bB[j5])) continue;" line614="            const o4 = tracked[j5];" line615="            if (o4 === b || o4 === pusher || !isAlive(o4)) continue;" line616="            return false;" line617="        }" line618="        return true;" line619="    }" line620="" line621="    // =====================================================================" line622="    // Settings: per sprite or per kind, and global" line623="    // =====================================================================" line624="" line625="    // Per-kind values; per-sprite values live in sprite.data. Sprite beats kind." line626="    class KindSetting {" line627="        constructor(public kind: number, public key: string, public value: number) { }" line628="    }" line629="    let kindSettings: KindSetting[];" line630="" line631="    function setFor(target: Sprite | number, key: string, value: number) {" line632="        if (typeof target === &quot;number&quot;) {" line633="            if (!kindSettings) kindSettings = [];" line634="            const kind = target as number;" line635="            for (const k2 of kindSettings) {" line636="                if (k2.kind === kind &amp;&amp; k2.key === key) { k2.value = value; return; }" line637="            }" line638="            kindSettings.push(new KindSetting(kind, key, value));" line639="        } else if (target) {" line640="            (target as Sprite).data[&quot;__sws_&quot; + key] = value;" line641="        }" line642="    }" line643="" line644="    function getFor(s: Sprite, key: string, fallback: number): number {" line645="        const v4 = s.data[&quot;__sws_&quot; + key];" line646="        if (v4 !== undefined) return v4;" line647="        if (kindSettings) {" line648="            const kind2 = s.kind();" line649="            for (const k3 of kindSettings) {" line650="                if (k3.kind === kind2 &amp;&amp; k3.key === key) return k3.value;" line651="            }" line652="        }" line653="        return fallback;" line654="    }" line655="" line656="    /**" line657="     * How fast a sprite (or every sprite of a kind) can be pushed, in pixels per second." line658="     * Overrides the speed in the push block. 0 = as fast as the pusher walks." line659="     * A row of things being pushed moves at the speed of the slowest one." line660="     */" line661="    //% block=&quot;set push speed of $target to $speed&quot;" line662="    //% group=&quot;Settings&quot; weight=100" line663="    //% target.shadow=spritekind" line664="    //% speed.defl=30 speed.min=0 speed.max=200" line665="    export function setPushSpeed(target: Sprite | number, speed: number) {" line666="        setFor(target, &quot;speed&quot;, Math.max(0, speed));" line667="    }" line668="" line669="    /**" line670="     * Turn pushing on or off for a sprite (or kind), e.g. to bolt a box in place." line671="     * When off it acts like a wall for everyone that could push it." line672="     */" line673="    //% block=&quot;set $target can be pushed $on&quot;" line674="    //% group=&quot;Settings&quot; weight=90" line675="    //% target.shadow=spritekind" line676="    //% on.shadow=toggleOnOff on.defl=true" line677="    export function setCanBePushed(target: Sprite | number, on: boolean) {" line678="        setFor(target, &quot;pushable&quot;, on ? 1 : 0);" line679="    }" line680="" line681="    /**" line682="     * Should sprites standing on this sprite (or kind) move along with it?" line683="     * On by default." line684="     */" line685="    //% block=&quot;set $target carries what stands on it $on&quot;" line686="    //% group=&quot;Settings&quot; weight=80" line687="    //% target.shadow=spritekind" line688="    //% on.shadow=toggleOnOff on.defl=true" line689="    export function setCarries(target: Sprite | number, on: boolean) {" line690="        setFor(target, &quot;carries&quot;, on ? 1 : 0);" line691="    }" line692="" line693="    let chainLimit: number; // default 8" line694="" line695="    /**" line696="     * How many things can be pushed in a row (player pushes player pushes box...)." line697="     * 0 = only the one you walk into. Default 8." line698="     */" line699="    //% block=&quot;set chain push limit to $count&quot;" line700="    //% group=&quot;Settings&quot; weight=70" line701="    //% count.defl=8 count.min=0 count.max=20" line702="    export function setChainLimit(count: number) {" line703="        chainLimit = Math.max(0, Math.floor(count));" line704="    }" line705="" line706="    /**" line707="     * How many pixels a sprite can step up onto another sprite when walking" line708="     * (so walking over a row of players or boxes doesn't snag). Default 3." line709="     */" line710="    //% block=&quot;set step up height to $pixels&quot;" line711="    //% group=&quot;Settings&quot; weight=60" line712="    //% pixels.defl=3 pixels.min=0 pixels.max=8" line713="    export function setStepUpHeight(pixels: number) {" line714="        stepUp = Math.max(0, pixels);" line715="    }" line716="" line717="    /**" line718="     * How many times per frame collisions are checked. More = big stacks settle" line719="     * better, fewer = faster game. Default 4." line720="     */" line721="    //% block=&quot;set collision passes to $passes&quot;" line722="    //% group=&quot;Settings&quot; weight=50 advanced=true" line723="    //% passes.defl=4 passes.min=1 passes.max=8" line724="    export function setCollisionPasses(passes: number) {" line725="        maxPasses = Math.max(1, Math.floor(passes));" line726="    }" line727="}" numlines="728"></mutation></block></statement></block></xml>